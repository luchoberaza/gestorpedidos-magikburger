{
  "name": "magikburger-launcher",
  "version": "1.1.1",
  "private": true,
  "main": "main.js",
  "description": "Launcher de escritorio para MagikBurger (misma UI web + backend auto-start)",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "instalador": "powershell -NoProfile -ExecutionPolicy Bypass -File armar-instalador.ps1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.magikburger.launcher",
    "productName": "MagikBurger Launcher",
    "artifactName": "Instalar-Magik.exe",
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../app.py",
        "to": "backend_app/app.py"
      },
      {
        "from": "../magik",
        "to": "backend_app/magik",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../templates",
        "to": "backend_app/templates"
      },
      {
        "from": "../static",
        "to": "backend_app/static"
      },
      {
        "from": "python",
        "to": "python"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
